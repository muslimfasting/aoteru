# PostgreSQL connection string (Neon / Vercel Postgres / local). Required.
DATABASE_URL=postgres://aoteru:aoteru@127.0.0.1:5432/aoteru

# World speed multiplier. 1 = real time (1 world tick per hour, as in the GDD).
# 60 = test world: one game hour passes every real minute.
WORLD_SPEED=60

# Secret that protects /api/cron/advance. Vercel Cron sends it automatically
# as "Authorization: Bearer <CRON_SECRET>" when this variable is set.
CRON_SECRET=change-me

# Optional: set to "true" to stop new registrations (closed test world).
# REGISTRATION_CLOSED=false
